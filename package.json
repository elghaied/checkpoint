{
  "name": "checkpoint",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Chrome side panel extension to track manga, manhwa, and manhua reading progress with auto chapter detection, new release notifications, and trending discovery",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "chrome-extension",
    "manga",
    "manhwa",
    "manhua",
    "manga-tracker",
    "manga-reader",
    "reading-tracker",
    "chapter-tracker",
    "webtoon",
    "comic",
    "comick",
    "anilist",
    "mangadex",
    "side-panel",
    "notifications",
    "trending",
    "reading-list"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.1.36",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
